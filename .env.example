RPC_ETHEREUM=
RPC_SEPOLIA=

# Postgres for accounts and API key records (Neon pooled connection string in production)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gaskiller_site

# Better Auth: generate the secret with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Resend, for confirmation and sign-in emails
RESEND_API_KEY=
EMAIL_FROM="Gas Killer <noreply@gaskiller.xyz>"

# Router that mints and verifies API keys; ADMIN_KEY is the router's admin secret and stays server-side
ROUTER_URL=https://testnet.gaskiller.xyz
ADMIN_KEY=

# Paragraph publication API key (publication settings); confirmed users who opt in are added to the newsletter
PARAGRAPH_API_KEY=

# /life demo: a router API key for its tasks, and a funded Sepolia key that relays each settlement (~142k gas per run)
LIFE_GK_API_KEY=
LIFE_RELAYER_PRIVATE_KEY=

# `npm test` reads TEST_DATABASE_URL from the shell, not from here: a disposable Postgres database it
# migrates and writes to. For example:
#   docker run --rm -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=gaskiller_test -p 54329:5432 postgres:16-alpine
#   TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/gaskiller_test npm test
